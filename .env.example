# Public URL used to access Arnotes. Use HTTPS in production.
BETTER_AUTH_URL=http://localhost:3000
APP_PORT=3000

# Docker Compose database URL. Keep the `postgres` hostname: Compose reads this
# file, so pointing it at localhost would leave the app container with no database.
# Outside Docker the `postgres` host is rewritten to localhost automatically, so
# native development works against the published port without editing this value.
DATABASE_URL=postgresql://arnotes:arnotes@postgres:5432/arnotes

# Optional. Docker generates and persists a secret when this is empty.
# Set a stable 32+ character value for production or non-Docker deployments.
BETTER_AUTH_SECRET=

# Allow new email/password accounts. Set to false after creating your account
# when the instance should be private.
ALLOW_SIGN_UP=true

# Optional Discord OAuth. Set all three values to enable the Discord button.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/discord
NUXT_PUBLIC_DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional GitHub OAuth. Set all three values to enable the GitHub button.
# Callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
NUXT_PUBLIC_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public client setting for native development. Compose derives this from the
# server setting above.
NUXT_PUBLIC_ALLOW_SIGN_UP=true
